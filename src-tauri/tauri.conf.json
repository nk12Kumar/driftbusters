{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Driftbusters",
  "version": "1.0.0",
  "identifier": "com.driftbusters.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Driftbusters",
        "width": 1440,
        "height": 940,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#0b0e14",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Driftbusters",
    "category": "Utility",
    "shortDescription": "Controller diagnostics for PlayStation and Xbox pads",
    "longDescription": "Driftbusters tests, diagnoses and analyses PlayStation and Xbox controllers: live input, stick drift, trigger response, button sweeps, side-by-side comparison and exportable health reports.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}